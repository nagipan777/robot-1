<?xml version="1.0"?>
<sdf version="1.9">
  <model name="demo_litter">
    <static>true</static>
    <link name="litter_link">
      <!-- Visual-only geometry keeps the camera target from changing Create3 physics. -->
      <visual name="can_body">
        <pose>0 0 0.085 1.57079632679 0 0.18</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.30</length></cylinder></geometry>
        <material>
          <ambient>0.65 0.68 0.72 1</ambient>
          <diffuse>0.88 0.90 0.94 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <visual name="red_label">
        <pose>0 0 0.087 1.57079632679 0 0.18</pose>
        <geometry><cylinder><radius>0.087</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.70 0.02 0.02 1</ambient>
          <diffuse>0.95 0.04 0.03 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="crumple_one">
        <pose>0.105 0.035 0.075 0 0 0</pose>
        <geometry><sphere><radius>0.075</radius></sphere></geometry>
        <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.8 0.82 0.86 1</diffuse></material>
      </visual>
      <visual name="crumple_two">
        <pose>-0.11 -0.025 0.07 0 0 0</pose>
        <geometry><sphere><radius>0.068</radius></sphere></geometry>
        <material><ambient>0.48 0.51 0.55 1</ambient><diffuse>0.74 0.77 0.81 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
