FROM ros:jazzy-ros-base-noble

COPY localization_core.py /opt/odometry-dryrun/localization_core.py
COPY odometry_dryrun_core.py /opt/odometry-dryrun/odometry_dryrun_core.py
COPY wheel_odometry_node.py /opt/odometry-dryrun/wheel_odometry_node.py
COPY odometry_aruco_ab.py /opt/odometry-dryrun/odometry_aruco_ab.py
COPY odometry_ros_e2e.py /usr/local/bin/odometry-ros-e2e
COPY odometry_aruco_ab.py /usr/local/bin/odometry-aruco-ab
COPY run_odometry_dryrun.py /usr/local/bin/run-odometry-dryrun
COPY odometry_dryrun_e2e.csv /etc/odometry-dryrun-e2e.csv

ENV PYTHONPATH=/opt/odometry-dryrun
RUN chmod +x /usr/local/bin/odometry-ros-e2e \
    /usr/local/bin/odometry-aruco-ab \
    /usr/local/bin/run-odometry-dryrun
